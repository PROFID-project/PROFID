to_binary_sex <- function(x) {
  if (is.numeric(x)) {
    # assume 1 = male / 0 = female if already binary-like
    out <- suppressWarnings(as.integer(x))
    return(out)
  }
  
  x_chr <- tolower(trimws(as.character(x)))
  dplyr::case_when(
    x_chr %in% c("m", "male", "man", "1") ~ 1L,
    x_chr %in% c("f", "female", "woman", "0") ~ 0L,
    TRUE ~ NA_integer_
  )
}

to_binary_icd <- function(x) {
  if (is.numeric(x)) return(suppressWarnings(as.integer(x)))
  
  x_chr <- tolower(trimws(as.character(x)))
  dplyr::case_when(
    x_chr %in% c("1", "yes", "y", "icd", "with icd") ~ 1L,
    x_chr %in% c("0", "no", "n", "non-icd", "without icd") ~ 0L,
    TRUE ~ NA_integer_
  )
}

