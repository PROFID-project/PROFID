band_from_year <- function(y) {
  dplyr::case_when(
    y >= 2000 & y <= 2004 ~ "2000-2004",
    y >= 2005 & y <= 2009 ~ "2005-2009",
    y >= 2010 & y <= 2014 ~ "2010-2014",
    y >= 2015 & y <= 2020 ~ "2015-2020",
    TRUE ~ NA_character_
  )
}

clean_lvef35_labels <- function(x) {
  x <- trimws(as.character(x))
  dplyr::case_when(
    x %in% c("<35%", "<35", "lt35", "LVEF <35%", "LVEF<35%") ~ "LVEF <35%",
    x %in% c(">=35%", ">=35", "ge35", "LVEF >=35%", "LVEF ≥35%", "≥35%") ~ "LVEF >=35%",
    TRUE ~ x
  )
}

fmt_n_pct <- function(n, denom) {
  if (is.na(n) || is.na(denom) || denom <= 0) return("0 (0%)")
  pct <- round(100 * n / denom)
  paste0(format(n, big.mark = " ", scientific = FALSE), " (", pct, "%)")
}

fmt_median_q <- function(x, digits = 1) {
  x <- suppressWarnings(as.numeric(x))
  x <- x[!is.na(x)]
  if (length(x) == 0) return("NA")
  q <- stats::quantile(x, probs = c(0.25, 0.5, 0.75), na.rm = TRUE, names = FALSE)
  paste0(
    format(round(q[2], digits), nsmall = digits, trim = TRUE),
    " (",
    format(round(q[1], digits), nsmall = digits, trim = TRUE),
    ", ",
    format(round(q[3], digits), nsmall = digits, trim = TRUE),
    ")"
  )
}

get_first_existing <- function(df, candidates) {
  hit <- candidates[candidates %in% names(df)]
  if (length(hit) == 0) return(NA_character_)
  hit[1]
}

summarise_group <- function(df, label) {
  tibble(
    column = label,
    N = nrow(df),
    age = fmt_median_q(df$age_num, 0),
    female = fmt_n_pct(sum(df$sex_bin == 0, na.rm = TRUE), nrow(df)),
    male = fmt_n_pct(sum(df$sex_bin == 1, na.rm = TRUE), nrow(df)),
    cal_year = fmt_median_q(df$Year_index, 0),
    band_2000_2004 = fmt_n_pct(sum(df$band_2000_2020 == "2000-2004", na.rm = TRUE), nrow(df)),
    band_2005_2009 = fmt_n_pct(sum(df$band_2000_2020 == "2005-2009", na.rm = TRUE), nrow(df)),
    band_2010_2014 = fmt_n_pct(sum(df$band_2000_2020 == "2010-2014", na.rm = TRUE), nrow(df)),
    band_2015_2020 = fmt_n_pct(sum(df$band_2000_2020 == "2015-2020", na.rm = TRUE), nrow(df)),
    lvef = fmt_median_q(df$lvef_num, 0),
    egfr = fmt_median_q(df$egfr_num, 1)
  )
}

