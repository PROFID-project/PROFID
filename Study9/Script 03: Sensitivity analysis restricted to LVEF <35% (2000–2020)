get_summary_line <- function(df, cohort_name) {
  if (is.null(df) || nrow(df) == 0) return(NULL)
  if (!("cohort" %in% names(df))) return(NULL)
  
  x <- df %>% dplyr::filter(.data$cohort == cohort_name)
  if (nrow(x) == 0) return(NULL)
  
  paste0(
    unique(x$analysis)[1], " ", cohort_name, ": IRR per decade ",
    round(x$irr[1], 2),
    " (95% CI ", round(x$lcl[1], 2), "–", round(x$ucl[1], 2),
    "), p=", formatC(x$p_value[1], format = "f", digits = 3), "."
  )
}

