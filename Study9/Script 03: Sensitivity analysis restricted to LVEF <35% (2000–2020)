plot_band_pointrange_line <- function(df, y_rate, y_lo, y_hi, title, subtitle) {
  ggplot(df, aes(x = band, y = .data[[y_rate]], group = 1)) +
    geom_line(linewidth = 0.8) +
    geom_pointrange(aes(ymin = .data[[y_lo]], ymax = .data[[y_hi]]), linewidth = 0.7) +
    labs(
      title = title,
      subtitle = subtitle,
      x = "Calendar-time band",
      y = "Crude rate (events per 1,000 person-years)"
    ) +
    theme_journal
}

plot_year_ribbon <- function(df, y_rate, y_lo, y_hi,
                             title, subtitle,
                             cap = NA_real_,
                             break_year = NA_integer_,
                             vline_year = NA_integer_,
                             bottom_note = NULL,
                             x_by = 2,
                             rotate_x = TRUE) {
  
  d <- df %>%
    mutate(
      rate2 = .data[[y_rate]],
      lo2 = .data[[y_lo]],
      hi2 = .data[[y_hi]],
      rate_line = ifelse(!is.na(break_year) & Year_index == break_year, NA_real_, rate2),
      lo_line = ifelse(!is.na(break_year) & Year_index == break_year, NA_real_, lo2),
      hi_line = ifelse(!is.na(break_year) & Year_index == break_year, NA_real_, hi2)
    )
  
  if (!is.na(cap)) {
    d <- d %>%
      mutate(
        rate2 = cap_ci(rate2, cap),
        lo2 = cap_ci(lo2, cap),
        hi2 = cap_ci(hi2, cap),
        rate_line = cap_ci(rate_line, cap),
        lo_line = cap_ci(lo_line, cap),
        hi_line = cap_ci(hi_line, cap)
      )
  }
  
  p <- ggplot(d, aes(x = Year_index)) +
    geom_ribbon(aes(ymin = lo_line, ymax = hi_line), alpha = 0.18, na.rm = TRUE) +
    geom_line(aes(y = rate_line), linewidth = 0.9, na.rm = TRUE) +
    geom_point(aes(y = rate2), size = 1.6, na.rm = TRUE) +
    scale_x_continuous(
      limits = c(START_Y, END_Y),
      breaks = seq(START_Y, END_Y, by = x_by),
      expand = c(0, 0)
    ) +
    labs(
      title = title,
      subtitle = subtitle,
      x = "Calendar year",
      y = "Crude rate (events per 1,000 person-years)"
    ) +
    theme_journal
  
  if (!is.na(vline_year)) {
    p <- p + geom_vline(xintercept = vline_year, linetype = "dashed", linewidth = 0.6)
  }
  
  if (!is.na(cap)) {
    p <- p + coord_cartesian(ylim = c(0, cap), clip = "off")
  }
  
  if (!is.null(bottom_note)) {
    p <- p +
      labs(caption = bottom_note) +
      theme(
        plot.caption = element_text(hjust = 0, size = 9, margin = margin(t = 8)),
        plot.margin = margin(10, 10, 24, 10)
      )
  }
  
  if (isTRUE(rotate_x)) {
    p <- p + theme(axis.text.x = element_text(angle = 45, hjust = 1))
  }
  
  p
}

# ----- model helpers -----
fit_rate_model_agg <- function(formula_obj, data) {
  m_pois <- glm(
    formula_obj,
    data = data,
    family = poisson(link = "log")
  )
  
  disp <- sum(residuals(m_pois, type = "pearson")^2, na.rm = TRUE) / m_pois$df.residual
  
  if (is.finite(disp) && disp > 1.5) {
    m_nb <- MASS::glm.nb(formula_obj, data = data)
    list(model = m_nb, family = "negative binomial", dispersion = disp)
  } else {
    list(model = m_pois, family = "poisson", dispersion = disp)
  }
}

safe_adjusted_model <- function(df, formula_obj) {
  df_fit <- tryCatch(
    model.frame(formula_obj, data = df, na.action = na.omit),
    error = function(e) NULL
  )
  
  if (is.null(df_fit)) return(NULL)
  if (nrow(df_fit) < 8) return(NULL)
  
  tryCatch(
    fit_rate_model_agg(formula_obj, data = df_fit),
    error = function(e) NULL
  )
}

extract_trend_row <- function(model_obj, term_name = "year_decade") {
  broom::tidy(model_obj, conf.int = TRUE, exponentiate = TRUE) %>%
    dplyr::filter(term == term_name) %>%
    dplyr::transmute(
      term = term,
      irr = estimate,
      lcl = conf.low,
      ucl = conf.high,
      p_value = p.value,
      pct_change_per_decade = (estimate - 1) * 100,
      pct_change_lcl = (conf.low - 1) * 100,
      pct_change_ucl = (conf.high - 1) * 100
    )
}

