# 9) FORMAL TEMPORAL TREND ANALYSIS — ADJUSTED
# ==============================================================================
build_adjusted_year_data <- function(df, event_var) {
  df %>%
    group_by(Year_index) %>%
    summarise(
      events = sum(.data[[event_var]] == 1L, na.rm = TRUE),
      person_years = sum(ifelse(!is.na(person_years) & person_years > 0, person_years, 0), na.rm = TRUE),
      age_mean = mean(age_num, na.rm = TRUE),
      male_prop = mean(male_bin, na.rm = TRUE),
      egfr_mean = mean(egfr_num, na.rm = TRUE),
      lvef_mean = mean(LVEF_num, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(
      year_decade = (Year_index - 2000) / 10,
      age_mean = ifelse(is.nan(age_mean), NA_real_, age_mean),
      male_prop = ifelse(is.nan(male_prop), NA_real_, male_prop),
      egfr_mean = ifelse(is.nan(egfr_mean), NA_real_, egfr_mean),
      lvef_mean = ifelse(is.nan(lvef_mean), NA_real_, lvef_mean)
    ) %>%
    filter(person_years > 0)
}

adjusted_results <- list()

nonicd_adj_data <- build_adjusted_year_data(dat %>% filter(cohort == "Non-ICD"), "SCD_bin")
icd_adj_data <- build_adjusted_year_data(dat %>% filter(cohort == "ICD"), "ICD_proxy_bin")

