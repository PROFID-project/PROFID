band_from_year <- function(y) {
  dplyr::case_when(
    y >= 2000 & y <= 2004 ~ "2000-2004",
    y >= 2005 & y <= 2009 ~ "2005-2009",
    y >= 2010 & y <= 2014 ~ "2010-2014",
    y >= 2015 & y <= 2020 ~ "2015-2020",
    TRUE ~ NA_character_
  )
}

band_levels <- c("2000-2004", "2005-2009", "2010-2014", "2015-2020")

rate_ci_poisson <- function(events, py, mult = 1000) {
  events <- as.numeric(events)
  py <- as.numeric(py)
  
  rate <- ifelse(py > 0, mult * events / py, NA_real_)
  lo <- rep(NA_real_, length(events))
  hi <- rep(NA_real_, length(events))
  
  ok <- !is.na(events) & !is.na(py) & py > 0
  
  if (any(ok)) {
    lo[ok] <- ifelse(
      events[ok] == 0,
      0,
      mult * 0.5 * qchisq(0.025, 2 * events[ok]) / py[ok]
    )
    hi[ok] <- mult * 0.5 * qchisq(0.975, 2 * (events[ok] + 1)) / py[ok]
  }
  
  tibble(rate = rate, lo = lo, hi = hi)
}

