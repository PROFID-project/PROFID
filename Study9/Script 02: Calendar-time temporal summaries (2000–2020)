plot_annual <- function(df, title, subtitle,
                        cap = NA_real_,
                        break_year = NA_integer_,
                        add_break_note = FALSE) {
  d <- df %>%
    mutate(
      rate_line = ifelse(!is.na(break_year) & Year_index == break_year, NA_real_, rate),
      lo_line = ifelse(!is.na(break_year) & Year_index == break_year, NA_real_, lo),
      hi_line = ifelse(!is.na(break_year) & Year_index == break_year, NA_real_, hi)
    )
  
  if (!is.na(cap)) {
    d <- d %>%
      mutate(
        rate = pmin(rate, cap),
        lo = pmin(lo, cap),
        hi = pmin(hi, cap),
        rate_line = pmin(rate_line, cap),
        lo_line = pmin(lo_line, cap),
        hi_line = pmin(hi_line, cap)
      )
  }
  
  p <- ggplot(d, aes(x = Year_index)) +
    geom_ribbon(aes(ymin = lo_line, ymax = hi_line), alpha = 0.18, na.rm = TRUE) +
    geom_line(aes(y = rate_line), linewidth = 0.9, na.rm = TRUE) +
    geom_point(aes(y = rate), size = 1.6, na.rm = TRUE) +
    scale_x_continuous(
      limits = c(START_Y, END_Y),
      breaks = seq(START_Y, END_Y, by = XBY_ANNUAL),
      expand = c(0, 0)
    ) +
    labs(
      title = title,
      subtitle = subtitle,
      x = "Calendar year",
      y = "Crude rate (events per 1,000 person-years)"
    ) +
    theme_journal +
    theme(
      axis.text.x = element_text(angle = 45, hjust = 1),
      plot.margin = margin(10, 10, 45, 10)
    )
  
  if (!is.na(cap)) {
    p <- p + coord_cartesian(ylim = c(0, cap), clip = "off")
  }
  
  if (!is.na(break_year)) {
    p <- p + geom_vline(
      xintercept = break_year,
      linetype = "dashed",
      linewidth = 0.6
    )
  }
  
  if (isTRUE(add_break_note) && !is.na(break_year)) {
    p <- p +
      annotate(
        "text",
        x = START_Y + 0.2, # à gauche
        y = 0,
        hjust = 0, # aligné à gauche
        vjust = 10, # plus bas sous le graphe
        size = 3.1,
        label = "Dashed line: 2005 estimate unstable due to very low person-time; curve broken at 2005."
      )
  }
  
  p
}

fit_rate_model <- function(formula_obj, data) {
  m_pois <- glm(
    formula_obj,
    data = data,
    family = poisson(link = "log")
  )
  
  disp <- sum(residuals(m_pois, type = "pearson")^2, na.rm = TRUE) / m_pois$df.residual
  
  if (is.finite(disp) && disp > 1.5) {
    m_nb <- MASS::glm.nb(formula_obj, data = data)
    return(list(model = m_nb, family = "negative binomial", dispersion = disp))
  } else {
    return(list(model = m_pois, family = "poisson", dispersion = disp))
  }
}

extract_trend_row <- function(model_obj, term_name = "year_decade") {
  broom::tidy(model_obj, conf.int = TRUE, exponentiate = TRUE) %>%
    filter(term == term_name) %>%
    transmute(
      term = term,
      irr = estimate,
      lcl = conf.low,
      ucl = conf.high,
      p_value = p.value,
      pct_change_per_decade = (estimate - 1) * 100,
      pct_change_lcl = (conf.low - 1) * 100,
      pct_change_ucl = (conf.high - 1) * 100
    )
}

extract_interaction_row <- function(model_obj, pattern = "year_decade:lvef35_grp") {
  broom::tidy(model_obj, conf.int = TRUE, exponentiate = TRUE) %>%
    filter(grepl(pattern, term)) %>%
    transmute(
      term = term,
      irr = estimate,
      lcl = conf.low,
      ucl = conf.high,
      p_value = p.value,
      pct_change_per_decade = (estimate - 1) * 100,
      pct_change_lcl = (conf.low - 1) * 100,
      pct_change_ucl = (conf.high - 1) * 100
    )
}

safe_lrt <- function(model_reduced, model_full) {
  out <- tryCatch(
    anova(model_reduced, model_full, test = "Chisq"),
    error = function(e) NULL
  )
  
  if (is.null(out) || nrow(out) < 2) {
    return(tibble(
      comparison = "LRT",
      df = NA_real_,
      deviance = NA_real_,
      p_value = NA_real_
    ))
  }
  
  tibble(
    comparison = "LRT",
    df = suppressWarnings(as.numeric(out$Df[nrow(out)])),
    deviance = suppressWarnings(as.numeric(out$Deviance[nrow(out)])),
    p_value = suppressWarnings(as.numeric(out$`Pr(>Chi)`[nrow(out)]))
  )
}

derive_subgroup_trends_from_interaction <- function(model_obj) {
  cf <- coef(model_obj)
  vc <- tryCatch(vcov(model_obj), error = function(e) NULL)
  
  if (is.null(vc) || !"year_decade" %in% names(cf)) {
    return(tibble(
      subgroup = c("LVEF >=35%", "LVEF <35%"),
      log_irr_per_decade = NA_real_,
      irr = NA_real_,
      lcl = NA_real_,
      ucl = NA_real_,
      pct_change_per_decade = NA_real_,
      pct_change_lcl = NA_real_,
      pct_change_ucl = NA_real_
    ))
  }
  
  time_name <- "year_decade"
  int_name <- names(cf)[grepl("year_decade:lvef35_grp", names(cf))]
  if (length(int_name) == 0) int_name <- NA_character_ else int_name <- int_name[1]
  
  beta_ref <- unname(cf[time_name])
  se_ref <- sqrt(vc[time_name, time_name])
  ref_lcl <- beta_ref - qnorm(0.975) * se_ref
  ref_ucl <- beta_ref + qnorm(0.975) * se_ref
  
  if (!is.na(int_name)) {
    beta_lt35 <- unname(cf[time_name] + cf[int_name])
    var_lt35 <- vc[time_name, time_name] + vc[int_name, int_name] + 2 * vc[time_name, int_name]
    se_lt35 <- sqrt(var_lt35)
    lt35_lcl <- beta_lt35 - qnorm(0.975) * se_lt35
    lt35_ucl <- beta_lt35 + qnorm(0.975) * se_lt35
  } else {
    beta_lt35 <- NA_real_
    lt35_lcl <- NA_real_
    lt35_ucl <- NA_real_
  }
  
  tibble(
    subgroup = c("LVEF >=35%", "LVEF <35%"),
    log_irr_per_decade = c(beta_ref, beta_lt35),
    irr = exp(log_irr_per_decade),
    lcl = exp(c(ref_lcl, lt35_lcl)),
    ucl = exp(c(ref_ucl, lt35_ucl))
  ) %>%
    mutate(
      pct_change_per_decade = (irr - 1) * 100,
      pct_change_lcl = (lcl - 1) * 100,
      pct_change_ucl = (ucl - 1) * 100
    )
}

