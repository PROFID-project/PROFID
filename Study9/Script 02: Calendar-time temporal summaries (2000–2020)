  mutate(year_decade = (Year_index - 2000) / 10) %>%
  filter(person_years > 0)

nonicd_lvef_year_model <- nonicd_lvef_year %>%
  mutate(
    year_decade = (Year_index - 2000) / 10,
    lvef35_grp = factor(lvef35_grp, levels = c("LVEF >=35%", "LVEF <35%"))
  ) %>%
  filter(person_years > 0)

mod_nonicd_unadj <- fit_rate_model(
  events ~ year_decade + offset(log(person_years)),
  data = nonicd_year_model
)

res_nonicd_unadj <- extract_trend_row(mod_nonicd_unadj$model, "year_decade") %>%
  mutate(
    analysis = "Unadjusted",
    cohort = "Non-ICD",
    outcome = "SCD",
    model_family = mod_nonicd_unadj$family,
    dispersion = mod_nonicd_unadj$dispersion
  )

mod_icd_unadj <- fit_rate_model(
  events ~ year_decade + offset(log(person_years)),
  data = icd_year_model
)

res_icd_unadj <- extract_trend_row(mod_icd_unadj$model, "year_decade") %>%
  mutate(
    analysis = "Unadjusted",
    cohort = "ICD",
    outcome = "Appropriate ICD therapy proxy",
    model_family = mod_icd_unadj$family,
    dispersion = mod_icd_unadj$dispersion
  )

mod_nonicd_lvef_main_unadj <- fit_rate_model(
