)

# ==============================================================================
# 10) ADJUSTED TEMPORAL TREND ANALYSIS
# ==============================================================================
# Individual-level Poisson/NB models with log(person_years) offset
# Minimal robust adjustment:
# - non-ICD: year_decade + age + sex + eGFR + LVEF
# - ICD: year_decade + age + sex + eGFR
# - non-ICD interaction: year_decade * lvef35_grp + age + sex + eGFR

covar_ready <- c(
  !all(is.na(dat$age_num)),
  !all(is.na(dat$sex_clean)),
  !all(is.na(dat$egfr_num))
)

if (all(covar_ready)) {
  
  # ---------------------------------------------------------------------------
  # 10A) Non-ICD adjusted model
  # ---------------------------------------------------------------------------
  dat_nonicd_adj <- dat %>%
    filter(
      ICD_bin == 0,
      !is.na(SCD_bin),
      !is.na(year_decade),
      !is.na(age_num),
      !is.na(sex_clean),
      !is.na(egfr_num),
      person_years > 0
    ) %>%
    mutate(
      sex_clean = factor(sex_clean, levels = c("Female", "Male"))
    )
  
  if (!all(is.na(dat_nonicd_adj$lvef_num))) {
    dat_nonicd_adj <- dat_nonicd_adj %>%
      filter(!is.na(lvef_num))
    
    mod_nonicd_adj <- fit_rate_model(
      SCD_bin ~ year_decade + age_num + sex_clean + egfr_num + lvef_num + offset(log(person_years)),
      data = dat_nonicd_adj
    )
    
    adj_nonicd_formula_label <- "SCD_bin ~ year_decade + age + sex + eGFR + continuous LVEF + offset(log(person_years))"
  } else {
    dat_nonicd_adj <- dat_nonicd_adj %>%
      filter(!is.na(lvef35_grp), lvef35_grp %in% valid_lvef_groups) %>%
      mutate(lvef35_grp = factor(lvef35_grp, levels = c("LVEF >=35%", "LVEF <35%")))
    
    mod_nonicd_adj <- fit_rate_model(
      SCD_bin ~ year_decade + age_num + sex_clean + egfr_num + lvef35_grp + offset(log(person_years)),
      data = dat_nonicd_adj
    )
    
    adj_nonicd_formula_label <- "SCD_bin ~ year_decade + age + sex + eGFR + LVEF group + offset(log(person_years))"
  }
  
  res_nonicd_adj <- extract_trend_row(mod_nonicd_adj$model, "year_decade") %>%
    mutate(
      analysis = "Adjusted",
      cohort = "Non-ICD",
      outcome = "SCD",
      model_family = mod_nonicd_adj$family,
      dispersion = mod_nonicd_adj$dispersion,
      n_complete_case = nrow(dat_nonicd_adj),
      model_formula = adj_nonicd_formula_label
    )
  
  # ---------------------------------------------------------------------------
  # 10B) ICD adjusted model
  # ---------------------------------------------------------------------------
  dat_icd_adj <- dat %>%
    filter(
      ICD_bin == 1,
      !is.na(ICD_proxy_bin),
      !is.na(year_decade),
      !is.na(age_num),
      !is.na(sex_clean),
      !is.na(egfr_num),
      person_years > 0
    ) %>%
    mutate(
      sex_clean = factor(sex_clean, levels = c("Female", "Male"))
    )
  
  mod_icd_adj <- fit_rate_model(
    ICD_proxy_bin ~ year_decade + age_num + sex_clean + egfr_num + offset(log(person_years)),
    data = dat_icd_adj
  )
  
  res_icd_adj <- extract_trend_row(mod_icd_adj$model, "year_decade") %>%
    mutate(
      analysis = "Adjusted",
      cohort = "ICD",
      outcome = "Appropriate ICD therapy proxy",
      model_family = mod_icd_adj$family,
      dispersion = mod_icd_adj$dispersion,
      n_complete_case = nrow(dat_icd_adj),
      model_formula = "ICD_proxy_bin ~ year_decade + age + sex + eGFR + offset(log(person_years))"
    )
  
  # ---------------------------------------------------------------------------
  # 10C) Non-ICD adjusted interaction model by LVEF subgroup
  # ---------------------------------------------------------------------------
  dat_nonicd_lvef_adj <- dat %>%
    filter(
      ICD_bin == 0,
      !is.na(SCD_bin),
      !is.na(year_decade),
      !is.na(age_num),
      !is.na(sex_clean),
      !is.na(egfr_num),
      !is.na(lvef35_grp),
      lvef35_grp %in% valid_lvef_groups,
      person_years > 0
    ) %>%
    mutate(
      sex_clean = factor(sex_clean, levels = c("Female", "Male")),
      lvef35_grp = factor(lvef35_grp, levels = c("LVEF >=35%", "LVEF <35%"))
    )
  
  mod_nonicd_lvef_main_adj <- fit_rate_model(
    SCD_bin ~ year_decade + lvef35_grp + age_num + sex_clean + egfr_num + offset(log(person_years)),
    data = dat_nonicd_lvef_adj
  )
  
  mod_nonicd_lvef_int_adj <- fit_rate_model(
    SCD_bin ~ year_decade * lvef35_grp + age_num + sex_clean + egfr_num + offset(log(person_years)),
    data = dat_nonicd_lvef_adj
  )
  
  res_nonicd_lvef_main_adj <- extract_trend_row(mod_nonicd_lvef_main_adj$model, "year_decade") %>%
    mutate(
      analysis = "Adjusted",
      cohort = "Non-ICD",
      subgroup = "Reference subgroup: LVEF >=35%",
      outcome = "SCD",
      model_family = mod_nonicd_lvef_main_adj$family,
      dispersion = mod_nonicd_lvef_main_adj$dispersion,
      n_complete_case = nrow(dat_nonicd_lvef_adj),
      model_formula = "SCD_bin ~ year_decade + lvef35_grp + age + sex + eGFR + offset(log(person_years))"
    )
  
  res_nonicd_lvef_interaction_adj <- extract_interaction_row(mod_nonicd_lvef_int_adj$model) %>%
    mutate(
      analysis = "Adjusted",
      cohort = "Non-ICD",
      outcome = "SCD",
      model_family = mod_nonicd_lvef_int_adj$family,
      dispersion = mod_nonicd_lvef_int_adj$dispersion,
      n_complete_case = nrow(dat_nonicd_lvef_adj),
      model_formula = "SCD_bin ~ year_decade * lvef35_grp + age + sex + eGFR + offset(log(person_years))"
    )
  
  lrt_nonicd_lvef_interaction_adj <- safe_lrt(
    mod_nonicd_lvef_main_adj$model,
    mod_nonicd_lvef_int_adj$model
  ) %>%
    mutate(
      analysis = "Adjusted",
      cohort = "Non-ICD",
      outcome = "SCD",
      comparison_label = "year_decade * lvef35_grp interaction",
      n_complete_case = nrow(dat_nonicd_lvef_adj)
    )
  
  res_nonicd_lvef_subgroup_adj <- derive_subgroup_trends_from_interaction(mod_nonicd_lvef_int_adj$model) %>%
    mutate(
      analysis = "Adjusted",
      cohort = "Non-ICD",
      outcome = "SCD",
      model_family = mod_nonicd_lvef_int_adj$family,
      dispersion = mod_nonicd_lvef_int_adj$dispersion,
      n_complete_case = nrow(dat_nonicd_lvef_adj),
      model_formula = "SCD_bin ~ year_decade * lvef35_grp + age + sex + eGFR + offset(log(person_years))"
    )
  
  write_excel_csv(
    bind_rows(res_nonicd_adj, res_icd_adj),
    file.path(OUT_DIR, "Adjusted_temporal_trend_results_main.csv")
  )
  
  write_excel_csv(
    res_nonicd_lvef_main_adj,
    file.path(OUT_DIR, "Adjusted_temporal_trend_nonICD_LVEF_main_effect.csv")
  )
  
  write_excel_csv(
    res_nonicd_lvef_interaction_adj,
    file.path(OUT_DIR, "Adjusted_temporal_trend_nonICD_LVEF_interaction_terms.csv")
  )
  
  write_excel_csv(
    lrt_nonicd_lvef_interaction_adj,
    file.path(OUT_DIR, "Adjusted_temporal_trend_nonICD_LVEF_interaction_LRT.csv")
  )
  
  write_excel_csv(
    res_nonicd_lvef_subgroup_adj,
    file.path(OUT_DIR, "Adjusted_temporal_trend_nonICD_LVEF_subgroup_specific.csv")
  )
  
  adjusted_summary_lines <- c(
    paste0(
      "Adjusted non-ICD model: IRR per decade = ", round(res_nonicd_adj$irr[1], 3),
      " (95% CI ", round(res_nonicd_adj$lcl[1], 3), " to ", round(res_nonicd_adj$ucl[1], 3), ")",
      "; percent change per decade = ", round(res_nonicd_adj$pct_change_per_decade[1], 1), "%",
      " (95% CI ", round(res_nonicd_adj$pct_change_lcl[1], 1), "% to ", round(res_nonicd_adj$pct_change_ucl[1], 1), "%)",
      "; p = ", signif(res_nonicd_adj$p_value[1], 3), "."
    ),
    paste0(
      "Adjusted ICD model: IRR per decade = ", round(res_icd_adj$irr[1], 3),
      " (95% CI ", round(res_icd_adj$lcl[1], 3), " to ", round(res_icd_adj$ucl[1], 3), ")",
      "; percent change per decade = ", round(res_icd_adj$pct_change_per_decade[1], 1), "%",
      " (95% CI ", round(res_icd_adj$pct_change_lcl[1], 1), "% to ", round(res_icd_adj$pct_change_ucl[1], 1), "%)",
      "; p = ", signif(res_icd_adj$p_value[1], 3), "."
    ),
    paste0(
      "Adjusted non-ICD LVEF interaction LRT p = ",
      signif(lrt_nonicd_lvef_interaction_adj$p_value[1], 3), "."
    )
  )
  
  write_legend(
    file.path(OUT_DIR, "Adjusted_temporal_trend_text_ready_summary.txt"),
    adjusted_summary_lines
  )
  
  log_line("[OK] Adjusted temporal trend analysis completed.")
  
} else {
  log_line("[WARN] Adjusted temporal trend analysis skipped: one or more key covariates not available.")
}

