clean_lvef35_labels <- function(x) {
  x <- trimws(as.character(x))
  dplyr::case_when(
    x %in% c("<35%", "<35", "lt35", "LVEF <35%", "LVEF<35%") ~ "LVEF <35%",
    x %in% c(">=35%", ">=35", "ge35", "LVEF >=35%", "LVEF ≥35%", "≥35%", "LVEF >35%") ~ "LVEF >=35%",
    TRUE ~ x
  )
}

clean_sex_binary <- function(x) {
  y <- trimws(as.character(x))
  dplyr::case_when(
    y %in% c("1", "Male", "male", "M", "m", "man", "Men", "MEN") ~ "Male",
    y %in% c("0", "Female", "female", "F", "f", "woman", "Women", "WOMEN") ~ "Female",
    TRUE ~ NA_character_
  )
}

